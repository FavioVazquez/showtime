{
  "schema": 1,
  "about": "Pinned downloads for showtime setup. Every file has a sha256 and size; setup verifies both. Regenerate hashes when bumping a version. `showtime setup --plan` prints this as a table.",
  "tiers": {
    "minimal": "ffmpeg, Python venv, Node deps, Kokoro (timestamped fp16) + voices, a browser (CI tier)",
    "core": "minimal + Silero VAD, YuNet, arnndn models, FluidR3Mono SoundFont (MIT): the default install",
    "full": "core + every component fetched on first use (Parakeet v3, the vocal separator, Whisper small.en, Manim, the audio library, the produced-music catalog, SFX packs, icon packs, full Chromium) + asr-turbo, parakeet, diarize, events, supertonic, deepfilter"
  },
  "full_extras": [
    "asr-turbo",
    "parakeet",
    "diarize",
    "events",
    "supertonic",
    "deepfilter",
    "music-catalog",
    "sfx-packs"
  ],
  "extras": {
    "asr-turbo": {
      "description": "Whisper large-v3-turbo (multilingual, highest accuracy; ~1.6 GB)"
    },
    "parakeet": {
      "description": "Parakeet-TDT 0.6B v2 via sherpa-onnx (English-only verbatim ASR; ~480 MB); `--model parakeet-v2` also fetches it on first use"
    },
    "diarize": {
      "description": "speaker diarization models (pyannote segmentation + TitaNet; ~50 MB)"
    },
    "events": {
      "description": "CED-mini audio event tagger (laughter/applause/music; ~50 MB)"
    },
    "supertonic": {
      "description": "Supertonic 3 multilingual TTS (Spanish and 30 more languages; ~400 MB)",
      "pip": [
        "supertonic==1.3.1"
      ]
    },
    "sf-generaluser": {
      "description": "GeneralUser GS General MIDI SoundFont (richer GM bank, used first when present; own free license; 32 MB)"
    },
    "sf-musescore": {
      "description": "MuseScore_General orchestral SoundFont (MIT; 40 MB, slow mirror)"
    },
    "deepfilter": {
      "description": "DeepFilterNet3 denoiser binary (~30 MB)"
    },
    "music-catalog": {
      "description": "every produced-music catalog track (Scott Buckley, Kevin MacLeod, CC0/public domain; 249 tracks, about 2.4 GB), pre-fetched for offline use; otherwise each track downloads the first time a mix uses it",
      "first_use": true,
      "when": "each track the first time a mix uses it"
    },
    "sfx-packs": {
      "description": "the extra CC0 sound-effect packs (foley, UI, impacts, ambience, crowd, weather; about 77 MB), pre-fetched; otherwise each pack downloads the first time it is needed",
      "first_use": true,
      "when": "each pack the first time a mix or search needs it"
    },
    "rife": {
      "description": "RIFE frame interpolation, ncnn/Vulkan GPU binary (430 MB download, 80 MB installed)"
    },
    "chromium": {
      "description": "Playwright's full Chromium, only needed for --headed captures when no Chrome/Edge is installed (fetched automatically then; renders use Chrome or the headless shell)",
      "when": "first --headed capture without a system browser",
      "download_bytes": {
        "linux-x64": 195836009,
        "linux-arm64": 195926016,
        "mac-x64": 201663099,
        "mac-arm64": 190970181,
        "win-x64": 205123748
      },
      "url": "https://cdn.playwright.dev/builds/cft/153.0.8010.12/{platform}/chrome-{platform}.zip (via `playwright install --no-shell chromium`)"
    },
    "musicgen": {
      "description": "MusicGen-small draft music in a separate venv (~3.5 GB). Weights are CC-BY-NC-4.0: non-commercial use only",
      "license_warning": "MusicGen weights are CC-BY-NC-4.0: output is for personal/demo/temp-track use only, not for commercial videos."
    },
    "manim": {
      "description": "Manim Community 0.21 (math and diagram animation, `showtime manim`) into the main venv (about 60 MB), installed automatically before the first Manim scene; macOS/Linux build pycairo against system cairo/pango; LaTeX is optional (equations)",
      "auto": true,
      "when": "first Manim scene",
      "approx_bytes": 60000000
    },
    "manimgl": {
      "description": "ManimGL 1.7.2 (optional OpenGL engine for scene files written with `from manimlib import *`) in its own venv ~/.showtime/venv-manimgl (about 150 MB); needs OpenGL 3.3",
      "auto": true,
      "when": "first ManimGL scene (from manimlib import *)",
      "approx_bytes": 150000000
    },
    "imagegen": {
      "description": "local image generation (not implemented yet; see references)",
      "todo": true
    },
    "aligner": {
      "description": "English CTC word aligner (wav2vec2-base-960h ONNX uint8, 95 MB, Apache-2.0); fetched on first use",
      "lazy": true
    },
    "piper": {
      "description": "Piper voices for sherpa-onnx (60-115 MB each, commercial-use voices only); fetched on first use",
      "lazy": true
    },
    "rembg": {
      "description": "rembg for non-macOS cutouts; installed on first use, then rembg downloads its default model, isnet-general-use (~170 MB), once (u2netp, ~5 MB, with --model u2netp)",
      "lazy": true
    }
  },
